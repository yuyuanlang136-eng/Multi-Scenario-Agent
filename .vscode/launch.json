{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BearCode: Full startup + REPL",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": true,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "BearCode: REPL with breakpoints",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "BearCode: One-shot",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": false,
      "subProcess": true,
      "args": [
        "阅读这个项目，解释 agent loop"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
